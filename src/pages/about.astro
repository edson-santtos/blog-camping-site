---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="Quem Somos"
  description={`Sobre o ${siteConfig.name} — o que publica e quem escreve.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Sobre</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>O que é publicado aqui</h2>
        <p>
          Análises detalhadas sobre equipamentos de camping e mochilão: as decisões por trás de uma
          indicação, o que pesamos e o que seria feito de forma diferente. Os artigos são escritos
          para serem lidos com atenção, não apenas skimmados.
        </p>

        <h2>Como é escrito</h2>
        <p>
          Cada artigo busca ser reprodutível e honesto sobre trade-offs. Se algo não funcionou,
          isso também entra. Correções são feitas no local, com a data de atualização exibida no
          início do artigo.
        </p>

        <h2>Quem escreve</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} ({author.posts.length} {author.posts.length === 1 ? "artigo" : "artigos"})
              </li>
            ))
          }
        </ul>

        <h2>Entre em contato</h2>
        <p>
          Dúvidas, correções e solicitações são bem-vindas pela <a href="/contact/">página de contato</a>.
        </p>
        {
          siteConfig.email && (
            <p>Você também pode enviar um e-mail diretamente para <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
