---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Privacidade" description={`Política de privacidade do ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Privacidade</p>
        <h1 class="pagehead-title">Política de privacidade</h1>
        <p class="pagehead-description">
          Texto inicial descrevendo o que uma publicação pode coletar e como é utilizado. Substitua
          pela sua própria política antes de publicar.
        </p>
      </header>

      <div class="prose">
        <h2>O que é coletado</h2>
        <p>
          Este site é gerado estaticamente e não define cookies próprios. Se o newsletter ou
          formulário de contato estiver conectado a um provedor, esse provedor recebe os dados que
          você envia.
        </p>

        <h2>Como é utilizado</h2>
        <p>
          Os dados enviados são utilizados apenas para responder a você ou para enviar os e-mails que
          você solicitou. Não são vendidos ou compartilhados para publicidade.
        </p>

        <h2>Sua preferência de leitura</h2>
        <p>
          O modo de leitura claro ou escuro que você escolhe é armazenado no armazenamento local do
          seu navegador sob <code>monograph-theme</code>. Nunca sai do seu dispositivo e você pode
          limpá-lo a qualquer momento.
        </p>

        <h2>Contato</h2>
        {
          siteConfig.email ? (
            <p>Para solicitações de privacidade, envie um e-mail para <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
          ) : (
            <p>Adicione um endereço de contato para privacidade em <code>src/config/site.ts</code> antes de publicar.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
