---
import LocalIcon from "@/components/LocalIcon.astro";
import { footerNavigation, siteConfig } from "@/config/site";

const socialIconByLabel = {
  Instagram: "instagram",
  YouTube: "youtube",
  RSS: "rss",
} as const;

const socials = siteConfig.socials.map((item) => ({
  ...item,
  icon: socialIconByLabel[item.label as keyof typeof socialIconByLabel] ?? "link-45deg",
}));
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo">
        <img
          src="/images/logo-diario-de-mochileiro.png"
          alt="Diário de Mochileiro"
          class="footer-logo-img"
        />
      </a>

      <ul class="footer-social">
        {
          socials.map((item) => (
            <li>
              <a
                href={item.href}
                class="footer-social-btn"
                aria-label={item.label === "RSS" ? "Feed RSS" : `${siteConfig.name} no ${item.label}`}
                rel={item.href.startsWith("http") ? "noreferrer" : undefined}
              >
                <LocalIcon name={item.icon} className="h-[0.9rem] w-[0.9rem]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="footer-nav" aria-label="Navegação do rodapé">
      {
        footerNavigation.map((item, index) => (
          <a
            href={item.href}
            class="footer-nav-link"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {currentYear} {siteConfig.name}. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--border);
  }

  .site-footer-inner {
    max-width: var(--layout-wide);
    margin-inline: auto;
    padding: 2.5rem var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    text-decoration: none;
  }

  .footer-logo-img {
    width: 180px;
    height: auto;
    max-width: 100%;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-social-btn {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    border-radius: var(--radius-full);
    transition:
      border-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .footer-social-btn:hover,
  .footer-social-btn:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
    transform: translateY(-1px);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .footer-nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted-foreground);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-nav-link:hover,
  .footer-nav-link:focus-visible {
    color: var(--foreground);
  }

  .footer-bottom {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    width: 100%;
    text-align: center;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 768px) {
    .site-footer-inner {
      padding: 3rem var(--gutter);
    }

    .footer-logo-img {
      width: 200px;
    }
  }
</style>
