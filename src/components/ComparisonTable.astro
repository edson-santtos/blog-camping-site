---
import { type ProdutoComparacao, plataformaConfig } from "@/data/products";

interface Props {
  titulo?: string;
  produtos: ProdutoComparacao[];
  exibirCta?: boolean;
  exibirAncoras?: boolean;
  exibirImagens?: boolean;
}

const { titulo, produtos, exibirCta = true, exibirAncoras = false, exibirImagens = false } = Astro.props;

const renderStars = (rating: number) => {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return { full, half, empty };
};

const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^\w-]/g, "");

const getAnchorId = (p: ProdutoComparacao) => p.anchorId ?? slugify(p.nome);

const getStoreLabel = (p: ProdutoComparacao) => {
  if (p.lojas && p.lojas.length > 0) {
    return p.lojas[0].nome;
  }
  if (p.plataforma) {
    return plataformaConfig[p.plataforma]?.label || "Ver produto";
  }
  return "Ver produto";
};

const getStoreUrl = (p: ProdutoComparacao) => {
  if (p.lojas && p.lojas.length > 0) {
    return p.lojas[0].url;
  }
  return p.linkAfiliado;
};

/* ── Single source of field descriptors ── */
interface FieldDescriptor {
  key: keyof ProdutoComparacao;
  label: string;
}

const allFields: FieldDescriptor[] = [
  { key: "melhorPara", label: "Melhor para" },
  { key: "colunaDagua", label: "Coluna d'água" },
  { key: "peso", label: "Peso" },
  { key: "capacidade", label: "Capacidade" },
  { key: "temperaturaMinima", label: "Temperatura" },
  { key: "rValue", label: "R-Value" },
  { key: "lumens", label: "Lumens" },
  { key: "autonomia", label: "Autonomia" },
];

const activeFields = allFields.filter((f) => produtos.some((p) => p[f.key]));
const hasAvaliacao = produtos.some((p) => p.avaliacao != null);
/* Guard: only render CTA column when at least one product has a real link */
const hasAnyStoreLink = produtos.some((p) => {
  const url = getStoreUrl(p);
  return url && url !== "";
});
const hasCta = exibirCta && hasAnyStoreLink;

const getFieldValue = (produto: ProdutoComparacao, key: keyof ProdutoComparacao): string => {
  const val = produto[key];
  return typeof val === "string" ? val : "";
};
---

<div class="comparison-wrapper">
  {titulo && <h3 class="comparison-title">{titulo}</h3>}

  {/* ── Desktop table (≥ 768px) ── */}
  <div class="comparison-scroll hidden md:block">
    <table class="comparison-table" aria-label={titulo || "Tabela comparativa de produtos"}>
      <thead>
        <tr>
          <th class="col-rank" scope="col">#</th>
          <th class="col-product" scope="col">Produto</th>
          {hasCta && (
            <th class="col-cta" scope="col">Loja</th>
          )}
          {activeFields.map((f) => (
            <th class="col-spec" scope="col">{f.label}</th>
          ))}
          {hasAvaliacao && (
            <th class="col-rating" scope="col">Avaliação</th>
          )}
        </tr>
      </thead>
      <tbody>
        {produtos.map((produto, index) => {
          const stars = produto.avaliacao ? renderStars(produto.avaliacao) : null;
          const storeUrl = getStoreUrl(produto);
          return (
            <tr>
              <td class="col-rank">
                <span class="rank-badge">{index + 1}</span>
              </td>
              <td class="col-product">
                <div class="product-cell">
                  {exibirImagens && produto.imagem && (
                    <img
                      src={produto.imagem}
                      alt={produto.nome}
                      class="product-thumb"
                      width="64"
                      height="64"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="product-info">
                    <span class="product-name">{produto.nome}</span>
                    {produto.categoria && (
                      <span class="product-category">{produto.categoria}</span>
                    )}
                    {exibirAncoras && (
                      <a
                        href={`#${getAnchorId(produto)}`}
                        class="anchor-link"
                      >
                        Ver análise completa ↓
                      </a>
                    )}
                  </div>
                </div>
              </td>
              {hasCta && (
                <td class="col-cta">
                  {storeUrl ? (
                    <a
                      href={storeUrl}
                      class="cta-btn"
                      target="_blank"
                      rel="sponsored nofollow noopener"
                    >
                      {getStoreLabel(produto)}
                    </a>
                  ) : (
                    ""
                  )}
                </td>
              )}
              {activeFields.map((f) => (
                <td class="col-spec">
                  {getFieldValue(produto, f.key)}
                </td>
              ))}
              {hasAvaliacao && (
                <td class="col-rating">
                  {stars ? (
                    <div class="rating-cell">
                      <div class="stars" aria-label={`${produto.avaliacao} de 5 estrelas`}>
                        {Array.from({ length: stars.full }).map(() => (
                          <svg class="star filled" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        ))}
                        {Array.from({ length: stars.half }).map(() => (
                          <svg class="star half" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        ))}
                        {Array.from({ length: stars.empty }).map(() => (
                          <svg class="star empty" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        ))}
                      </div>
                      <span class="rating-number">{produto.avaliacao?.toFixed(1)}</span>
                    </div>
                  ) : (
                    ""
                  )}
                </td>
              )}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {/* ── Mobile blocks (< 768px) ── */}
  <div class="comparison-mobile flex md:hidden">
    {produtos.map((produto, index) => {
      const storeUrl = getStoreUrl(produto);
      return (
        <div class="mobile-card">
          <div class="mobile-card-header">
            <span class="rank-badge">{index + 1}</span>
            {exibirImagens && produto.imagem && (
              <img
                src={produto.imagem}
                alt={produto.nome}
                class="mobile-thumb"
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="mobile-header-text">
              <strong class="mobile-product-name">{produto.nome}</strong>
              {exibirAncoras && (
                <a
                  href={`#${getAnchorId(produto)}`}
                  class="anchor-link"
                >
                  Ver análise completa ↓
                </a>
              )}
            </div>
          </div>
          {hasCta && storeUrl && (
            <a
              href={storeUrl}
              class="cta-btn cta-btn--block"
              target="_blank"
              rel="sponsored nofollow noopener"
            >
              {getStoreLabel(produto)}
            </a>
          )}
          <dl class="mobile-fields">
            {activeFields.map((f) => {
              const value = getFieldValue(produto, f.key);
              return value ? (
                <div class="mobile-field">
                  <dt>{f.label}</dt>
                  <dd>{value}</dd>
                </div>
              ) : null;
            })}
            {hasAvaliacao && produto.avaliacao != null && (
              <div class="mobile-field">
                <dt>Avaliação</dt>
                <dd>{produto.avaliacao.toFixed(1)}</dd>
              </div>
            )}
          </dl>
        </div>
      );
    })}
  </div>
</div>

<style>
  .comparison-wrapper {
    margin: 2rem 0;
  }

  .comparison-title {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .comparison-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .comparison-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .comparison-table thead {
    background: var(--muted);
    border-bottom: 1px solid var(--border);
  }

  .comparison-table th {
    padding: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    text-align: left;
    white-space: nowrap;
  }

  .comparison-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    color: var(--foreground);
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 3%, var(--background));
  }

  .col-rank {
    width: 2.5rem;
    text-align: center;
  }

  .col-product {
    min-width: 160px;
  }

  .col-spec {
    min-width: 75px;
    text-align: center;
    white-space: nowrap;
  }

  .col-rating {
    min-width: 85px;
  }

  .col-cta {
    min-width: 90px;
    text-align: center;
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-radius: 50%;
  }

  .product-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-thumb {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    border-radius: var(--radius-sm);
    background: var(--muted);
    flex-shrink: 0;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .product-name {
    font-weight: 600;
    color: var(--foreground);
    line-height: 1.3;
  }

  .product-category {
    font-size: 0.7rem;
    color: var(--muted-foreground);
  }

  .anchor-link {
    display: inline-block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .anchor-link:hover {
    text-decoration: underline;
    color: var(--foreground);
  }

  .rating-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .stars {
    display: flex;
    gap: 0.1rem;
  }

  .star {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--muted-foreground);
    opacity: 0.25;
  }

  .star.filled {
    color: #eab308;
    opacity: 1;
  }

  .star.half {
    color: #eab308;
    opacity: 0.5;
  }

  .rating-number {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .cta-btn {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #ffffff;
    background: #dc2626;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--duration) var(--ease-out);
  }

  .cta-btn:hover {
    background: #b91c1c;
  }

  /* ── Mobile cards ── */

  .comparison-mobile {
    flex-direction: column;
    gap: 0;
  }

  .mobile-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-bottom: 0.75rem;
  }

  .mobile-card:last-child {
    margin-bottom: 0;
  }

  .mobile-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .mobile-thumb {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    border-radius: var(--radius-sm);
    background: var(--muted);
    flex-shrink: 0;
  }

  .mobile-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .mobile-product-name {
    font-weight: 600;
    color: var(--foreground);
    line-height: 1.3;
  }

  .mobile-fields {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .mobile-field {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .mobile-field dt {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
    flex-shrink: 0;
  }

  .mobile-field dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--foreground);
    text-align: right;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .cta-btn--block {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: 0.75rem;
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .comparison-table {
      min-width: 480px;
    }

    .comparison-scroll::after {
      content: "arraste →";
      position: absolute;
      bottom: 0.5rem;
      right: 0.5rem;
      font-size: 0.65rem;
      color: var(--muted-foreground);
      opacity: 0.6;
      pointer-events: none;
    }
  }
</style>
