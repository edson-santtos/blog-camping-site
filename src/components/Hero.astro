---
---
<section class="hero">
  <img
    src="/images/hero-diario-de-mochileiro.png"
    alt="Acampamento junto a um lago com barraca, mochila e fogueira ao entardecer"
    class="hero-bg"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>
  <div class="hero-content outer">
    <div class="hero-inner">
      <p class="hero-eyebrow">Diário de Mochileiro</p>
      <h1 class="hero-title">
        Escolha melhor o que levar para a aventura.
      </h1>
      <p class="hero-subtitle">
        Análises de equipamentos para camping e mochilão, baseadas em especificações e experiências de compradores.
      </p>
      <div class="hero-actions">
        <a href="#curadoria" class="btn btn-solid">Ver equipamentos</a>
        <a href="/posts/" class="btn btn-outline-hero">Explorar o blog</a>
      </div>
      <div class="hero-badges">
        <span class="hero-badge">
          <svg class="hero-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
          Especificações dos produtos
        </span>
        <span class="hero-badge">
          <svg class="hero-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Relatos de compradores
        </span>
        <span class="hero-badge">
          <svg class="hero-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Análise antes da compra
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.40) 40%,
      rgba(0, 0, 0, 0.10) 70%,
      transparent 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(6rem, 12vw, 10rem);
  }

  .hero-inner {
    max-width: 40rem;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 2px;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
    color: #fff;
  }

  .hero-subtitle {
    max-width: 32rem;
    margin: 0.75rem 0 0;
    font-size: clamp(0.875rem, 2.2vw, 1.125rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .hero-actions :global(.btn) {
    font-size: 0.875rem;
    padding: 0.7rem 1.4rem;
  }

  .hero-actions :global(.btn-solid) {
    background: #fff;
    color: #111;
    border-color: #fff;
  }

  .hero-actions :global(.btn-solid:hover) {
    background: rgba(255, 255, 255, 0.88);
    color: #111;
  }

  .btn-outline-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    color: #fff;
    padding: 0.7rem 1.4rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .btn-outline-hero:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-badge-icon {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 85vh;
      align-items: flex-end;
    }

    .hero-bg {
      object-position: center 35%;
    }

    .hero-content {
      padding-bottom: 2rem;
    }

    .hero-title {
      font-size: clamp(1.6rem, 8vw, 2rem);
    }

    .hero-subtitle {
      font-size: 0.85rem;
    }

    .hero-badges {
      gap: 0.5rem 1rem;
    }

    .hero-badge {
      font-size: 0.65rem;
    }

    .hero-badge-icon {
      width: 0.75rem;
      height: 0.75rem;
    }
  }

  @media (min-width: 641px) and (max-width: 768px) {
    .hero {
      min-height: 75vh;
    }
  }

  @media (min-width: 769px) {
    .hero {
      min-height: 70vh;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .hero-bg {
      object-position: center center;
    }
  }
</style>
