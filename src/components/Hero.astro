---
---
<section class="hero-section outer">
  <div class="inner">
    <div class="hero-content">
      <p class="eyebrow">Curadoria Especializada</p>
      <h1 class="hero-title">
        Diário de Mochileiro
      </h1>
      <p class="hero-subtitle">
        Guia Prático de Equipamentos e Dicas de Camping
      </p>
      <p class="hero-description">
        Analisamos especificações técnicas e compilações de avaliações de compradores reais para
        recomendar os melhores equipamentos de camping e mochilão — sem rasgar dinheiro.
      </p>
      <div class="hero-actions">
        <a href="#curadoria" class="btn btn-solid">Ver Curadoria</a>
        <a href="#guia-rapido" class="btn btn-outline">Guia Rápido</a>
      </div>
      <div class="hero-badges">
        <span class="hero-badge">
          <svg class="hero-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Especificações Técnicas
        </span>
        <span class="hero-badge">
          <svg class="hero-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Avaliações Reais
        </span>
        <span class="hero-badge">
          <svg class="hero-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          Melhor Custo-Benefício
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 5%, var(--background)) 0%,
      var(--background) 100%
    );
  }

  .hero-content {
    max-width: 48rem;
  }

  .hero-title {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
    background: linear-gradient(135deg, var(--foreground) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    margin: 0.5rem 0 0;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 500;
    color: var(--accent);
  }

  .hero-description {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .hero-badge-icon {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }
</style>
