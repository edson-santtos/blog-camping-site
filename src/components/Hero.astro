---
---
<section class="hero">
  <picture class="hero-picture">
    <source
      media="(max-width: 640px)"
      srcset="/images/hero-mobile.jpeg"
    />
    <img
      src="/images/hero-desktop.jpg"
      alt="Acampamento junto a um lago ao entardecer com barraca, mochila e fogueira"
      class="hero-bg"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-overlay"></div>
  <div class="hero-content outer">
    <div class="hero-inner">
      <p class="hero-eyebrow">Diário de Mochileiro</p>
      <h1 class="hero-title">
        Equipamentos e dicas para camping e mochilão.
      </h1>
      <p class="hero-subtitle">
        Equipamentos e dicas para camping e mochilão.
      </p>
      <div class="hero-actions">
        <a href="#curadoria" class="btn-hero-solid">Ver equipamentos</a>
        <a href="/posts/" class="btn-hero-outline">Explorar o blog</a>
      </div>
      <div class="hero-badges">
        <span class="hero-badge">Especificações dos produtos</span>
        <span class="hero-badge-sep" aria-hidden="true"></span>
        <span class="hero-badge">Relatos de compradores</span>
        <span class="hero-badge-sep" aria-hidden="true"></span>
        <span class="hero-badge">Análise antes da compra</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .hero-picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.30) 45%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding-top: 0;
    padding-bottom: 2.25rem;
  }

  .hero-inner {
    max-width: 32rem;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.5rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 2px;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
    color: #fff;
  }

  .hero-subtitle {
    max-width: 28rem;
    margin: 0.5rem 0 0;
    font-size: clamp(0.8rem, 1.8vw, 0.95rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.15rem;
  }

  .btn-hero-solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.25rem;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid #fff;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .btn-hero-solid:hover {
    background: rgba(255, 255, 255, 0.88);
  }

  .btn-hero-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.25rem;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .btn-hero-outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hero-badge {
    font-size: 0.65rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-badge-sep {
    width: 3px;
    height: 3px;
    background: rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .hero {
      height: 300px;
    }

    .hero-bg {
      object-position: center 40%;
    }

    .hero-overlay {
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.70) 0%,
        rgba(0, 0, 0, 0.25) 50%,
        transparent 100%
      );
    }

    .hero-content {
      align-items: flex-end;
      padding-bottom: 1.5rem;
    }

    .hero-title {
      font-size: clamp(1.35rem, 6vw, 1.75rem);
    }

    .hero-subtitle {
      font-size: 0.8rem;
    }

    .hero-badges {
      gap: 0.35rem 0.6rem;
    }

    .hero-badge {
      font-size: 0.6rem;
    }

    .hero-badge-sep {
      width: 2px;
      height: 2px;
    }
  }

  @media (min-width: 641px) and (max-width: 768px) {
    .hero {
      height: 340px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: 420px;
    }

    .hero-bg {
      object-position: center center;
    }
  }
</style>
